<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>EF Core persistence (Sqlite demo profile, SqlServer/Azure SQL production profiles) plus identity wiring for the modern forms platform.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.14" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.14" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.14" />
    <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks.EntityFrameworkCore" Version="10.0.14" />
    <!-- Top-level pin: closes the transitive System.Security.Cryptography.Pkcs advisories. -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.14" />
    <!-- MySQL production target (Pomelo) — pinned per docs/migration-strategy.md:
    <PackageReference Include="Pomelo.EntityFrameworkCore.MySql" Version="9.0.0" />
    -->
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ModernForms.Domain\ModernForms.Domain.csproj" />
    <ProjectReference Include="..\ModernForms.Application\ModernForms.Application.csproj" />
  </ItemGroup>

</Project>
