@{
    ViewBag.Title = "Sign in";
}

<h2 class="screen-title">Sign in</h2>

@using (Html.BeginForm("Login", "Account", FormMethod.Post))
{
    @Html.AntiForgeryToken()

    <div class="login-card">
        <label>Employee key</label>
        <input type="text" name="employeeKey" placeholder="usr_amira" />
        <label>Password</label>
        <input type="password" name="password" autocomplete="off" />
        @if (ViewBag.Error != null)
        {
            <p class="error-text">@ViewBag.Error</p>
        }
        <button type="submit" class="btn">Sign in</button>
        <p class="hint">Demo keys: usr_amira · usr_tarek (employee), usr_mona (supervisor), usr_ossama (admin)</p>
    </div>
}
