<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <connectionStrings>
    <!-- Production: the same MySQL database the modern API reaches through the
         gateway during phase 1 of the migration (docs/migration-strategy.md). -->
    <add name="LegacyForms"
         connectionString="Server=mysql.office.internal;Port=3306;Database=legacyforms;User Id=legacyforms_app;Password=SET-IN-ENV;"
         providerName="MySql.Data.MySqlClient" />
  </connectionStrings>

  <appSettings>
    <add key="webpages:Version" value="3.0.0.0" />
    <add key="webpages:Enabled" value="false" />
  </appSettings>

  <system.web>
    <compilation debug="false" targetFramework="4.7.2">
      <assemblies>
        <add assembly="Microsoft.CSharp" />
      </assemblies>
    </compilation>
    <customErrors mode="Off" />
    <!-- Forms auth from the era: no tokens, no SSO — the migration plan
         replaces this with Azure AD SSO behind the modern API. -->
    <authentication mode="Forms">
      <forms loginUrl="~/Login" timeout="30" />
    </authentication>
    <sessionState mode="InProc" timeout="20" />
  </system.web>

  <system.webServer>
    <modules>
      <remove name="FormsAuthentication" />
      <add name="FormsAuthentication" type="System.Web.Security.FormsAuthenticationModule" />
    </modules>
    <handlers>
      <remove name="ExtensionlessUrlHandler-Integrated-4.0" />
      <remove name="OPTIONSVerbHandler" />
      <remove name="TRACEVerbHandler" />
      <add name="ExtensionlessUrlHandler-Integrated-4.0" path="*." verb="*"
           type="System.Web.Handlers.TransferRequestHandler" preCondition="integratedMode,runtimeVersionv4.0" />
    </handlers>
  </system.webServer>
</configuration>
